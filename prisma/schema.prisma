// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  GROOVE
  STAR
  VIP
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  password         String?
  avatar           String?
  bio              String?
  country          String?
  plan             Plan      @default(FREE)
  planExpiresAt    DateTime?
  songsPlayedMonth Int       @default(0)
  monthlyResetAt   DateTime  @default(now())
  emailVerified    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  payments  Payment[]

  @@map("users")
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  amount                Float
  currency              String        @default("USD")
  plan                  Plan
  status                PaymentStatus @default(PENDING)
  provider              String        @default("dusupay")
  txRef                 String        @unique   // our internal reference
  providerTransactionId String?                 // provider's internal ID
  providerRef           String?       @unique   // provider's public reference
  phoneNumber           String?                 // mobile money phone
  network               String?                 // e.g. "mtn_cm", "mpesa_ke"
  metadata              Json?                   // raw provider response
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
