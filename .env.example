# ============================================================
# A+ LYRICS — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ------ DATABASE (PostgreSQL — Supabase / Railway / Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ------ NEXTAUTH ----------------------------------------
NEXTAUTH_SECRET="generate-a-32-char-random-string-here"
NEXTAUTH_URL="http://localhost:3000"           # production: your domain

# ------ DUSUPAY PAYMENT GATEWAY -------------------------
# Sign up at https://dusupay.com — sandbox is free
# Sandbox base URL: https://sandbox.dusupay.com/v1
# Production base URL: https://api.dusupay.com/v1

DUSUPAY_API_KEY=
DUSUPAY_MERCHANT_ID=
DUSUPAY_SECRET_KEY=            # used for webhook HMAC verification
DUSUPAY_BASE_URL=https://sandbox.dusupay.com/v1
DUSUPAY_WEBHOOK_SECRET=        # set in DusuPay dashboard → Webhooks
DUSUPAY_CALLBACK_URL=          # e.g. https://your-domain.com/api/payment/webhook/dusupay
DUSUPAY_RETURN_URL=            # e.g. https://your-domain.com/api/payment/verify

# ------ PAYMENT PROVIDER --------------------------------
PAYMENT_PROVIDER=dusupay

# ------ APP -----------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"    # production: https://your-domain.com
FRONTEND_URL="http://localhost:3000"           # same as above for webhook redirects

# ------ OPTIONAL: GOOGLE OAUTH (add later) ---------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
