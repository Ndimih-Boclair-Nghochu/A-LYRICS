# ============================================================
# A+ LYRICS — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# ------ DATABASE (PostgreSQL — Supabase / Railway / Neon) --
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ------ NEXTAUTH ----------------------------------------
NEXTAUTH_SECRET="generate-a-32-char-random-string-here"
NEXTAUTH_URL="http://localhost:3000"           # production: your domain

# ------ FLUTTERWAVE PAYMENT GATEWAY -------------------
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_SECRET_KEY="FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_ENCRYPTION_KEY="your-encryption-key"
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"

# ------ APP -----------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"    # production: https://your-domain.com
NEXT_PUBLIC_APP_NAME="A+ LYRICS"

# ------ OPTIONAL: GOOGLE OAUTH (add later) ---------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
